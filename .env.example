# Copie para .env na raiz e preencha somente parametros publicos de build.
# O Flutter carrega este arquivo com --dart-define-from-file=.env.
# Nunca coloque client_secret, tokens, senhas ou credenciais de assinatura aqui.

# 1. Google OAuth e Google Drive
# Client ID OAuth do tipo Web application, usado como serverClientId no Android sem Firebase.
# Exemplo de formato: 1234567890-identificador.apps.googleusercontent.com
GOOGLE_SERVER_CLIENT_ID=

# Escopo de permissão do Google Drive (opcional, padrão: https://www.googleapis.com/auth/drive.file)
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file

# Tempo limite em segundos para requisições à Drive API (opcional, padrão: 15)
GOOGLE_DRIVE_TIMEOUT_SECONDS=15

# 2. Limites de Importação e Dados Locais
# Limite máximo de tamanho do arquivo CSV em megabytes (opcional, padrão: 5)
MAX_CSV_SIZE_MB=5

# Quantidade máxima de links permitidos em uma importação CSV (opcional, padrão: 10000)
MAX_CSV_IMPORT_LINKS=10000
